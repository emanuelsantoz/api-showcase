generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  COORDENADOR
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PresentationType {
  CANVA
  PDF
}

enum StorageProvider {
  CANVA
  VERCEL_BLOB
  CLOUDFLARE_R2
}

enum SemesterStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(STUDENT)
  courseId        String?
  course          Course?         @relation(fields: [courseId], references: [id])
  projects        ProjectMember[]
  likes           Like[]
  createdProjects Project[]       @relation("ProjectCreator")
  reviews         ProjectReview[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
}

model Course {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  users           User[]
  projects        Project[]
  semesterCourses SemesterCourse[]
}

model Project {
  id                       String               @id @default(uuid())
  title                    String
  shortDescription         String
  description              String               @db.Text
  submitterName            String?
  submitterEmail           String?
  revision                 Int                  @default(1)
  thumbnailUrl             String?
  thumbnailStorageProvider StorageProvider?
  thumbnailStorageKey      String?
  status                   ProjectStatus        @default(PENDING_REVIEW)
  isFeatured               Boolean              @default(false)
  viewsCount               Int                  @default(0)
  likesCount               Int                  @default(0)
  tags                     String[]             @default([])
  liveUrl                  String?
  prototypeUrl             String?
  repositoryUrl            String?
  courseId                 String
  course                   Course               @relation(fields: [courseId], references: [id])
  semesterId               String
  semester                 Semester             @relation(fields: [semesterId], references: [id])
  createdById              String?
  createdBy                User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members                  ProjectMember[]
  contributors             ProjectContributor[]
  likes                    Like[]
  presentation             ProjectPresentation?
  reviews                  ProjectReview[]
  accessTokens             ProjectAccessToken[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([status, isFeatured])
  @@index([courseId])
  @@index([semesterId, status])
  @@index([createdById])
}

model Semester {
  id        String           @id @default(uuid())
  year      Int
  number    Int
  code      String           @unique
  label     String
  theme     String?
  startsAt  DateTime
  endsAt    DateTime
  status    SemesterStatus   @default(DRAFT)
  projects  Project[]
  courses   SemesterCourse[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([year, number])
  @@index([status, startsAt])
}

model SemesterCourse {
  semesterId String
  courseId   String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([semesterId, courseId])
  @@index([courseId])
}

model ProjectReview {
  id         String         @id @default(uuid())
  projectId  String
  reviewerId String
  decision   ReviewDecision
  reason     String?        @db.Text
  createdAt  DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([reviewerId])
}

model ProjectAccessToken {
  id        String    @id @default(uuid())
  projectId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
}

model ProjectPresentation {
  id              String           @id @default(uuid())
  projectId       String           @unique
  type            PresentationType
  url             String
  storageProvider StorageProvider
  storageKey      String?
  contentType     String?
  sizeBytes       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  projectId String
  userId    String
  roleInfo  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ProjectContributor {
  id        String   @id @default(uuid())
  projectId String
  name      String
  email     String?
  roleInfo  String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Like {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}
