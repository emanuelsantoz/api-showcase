{
  "name": "academic-showcase-backend",
  "version": "1.0.0",
  "private": true,
  "main": "api/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "vercel-build": "prisma migrate deploy && npm run build",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma generate && tsx src/db/seed.ts",
    "db:seed:tags": "prisma generate && tsx src/db/seed-tags.ts"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@hono/node-server": "^1.11.1",
    "@hono/zod-validator": "^0.2.1",
    "@prisma/client": "^5.14.0",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.3.7",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
